# Server-side only. Never commit real values, never expose these to the browser.
NODE_ENV=development
DATABASE_URL=postgres://user:password@localhost:5432/backyardbook
AUTH_SECRET=change-me-long-random-string
SESSION_COOKIE_DOMAIN=localhost

# Sports data
SPORTS_API_KEY=
ODDS_API_KEY=

# Paystack: use TEST keys (sk_test_...) until you are licensed and live
PAYMENT_PROVIDER=paystack
PAYMENT_SECRET=sk_test_xxx
WEBHOOK_SECRET=whsec_xxx
PAYMENTS_LIVE=false
